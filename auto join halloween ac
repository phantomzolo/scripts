local ReplicatedStorage = game:GetService("ReplicatedStorage")

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local hal = {
    "_EVENT_HALLOWEEN_"
}

local eventsFolder = ReplicatedStorage:WaitForChild("endpoints")
local clientFolder = eventsFolder:WaitForChild("client_to_server")

local enterEvent = clientFolder:WaitForChild("request_join_lobby")
local startEvent = clientFolder:WaitForChild("request_start_game")

pcall(function()
    enterEvent:InvokeServer(unpack(hal))
    task.wait(0.3)
    startEvent:InvokeServer(unpack(hal))
end)

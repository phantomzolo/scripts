local r5 = game:GetService("ReplicatedStorage")
local w5 = game:GetService("Workspace")

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local f9 = r5.endpoints.server_to_client.game_finished
local v2 = r5.endpoints.client_to_server.set_game_finished_vote
local l7 = w5._GATES.gates

local p1 = {
    ["Godlike Contract"] = 6,
    ["Mythic Contract"] = 5,
    ["Legendary Contract"] = 4,
    ["Elite Contract"] = 3,
    ["Standard Contract"] = 2,
    ["Rookie Contract"] = 1,
}

local function x8()
    local BestGate = nil
    local BestType = nil
    local BestIndex = nil
    local HighestValue = -1

    for i = 1, 11 do
        local Gate = l7:FindFirstChild(tostring(i))

        if Gate then
            local GateType = Gate:FindFirstChild("GateType")
            local Challenge = Gate:FindFirstChild("challenge")

            if GateType and GateType.Value then
                local ContractName = GateType.Value
                local ChallengeValue = Challenge and Challenge.Value or ""

                -- SKIP DOUBLE COST
                if ChallengeValue == "double_cost" then
                    print("Skipped Double Cost:", Gate.Name, ContractName)

                else
                    local Value = p1[ContractName]

                    print("Checking:", Gate.Name, ContractName, "Value:", Value)

                    if Value and Value > HighestValue then
                        HighestValue = Value
                        BestGate = Gate.Name
                        BestType = ContractName
                        BestIndex = i
                    end
                end
            end
        end
    end

    return BestGate, BestType, BestIndex
end

f9.OnClientEvent:Connect(function()
    print("Game Finished")

    task.wait(2)

    local GateName, ContractType, GateIndex = x8()

    if GateName and GateIndex then
        print("Selected:", GateName, ContractType)

        v2:InvokeServer(
            "play_gate_next",
            {
                GateUuid = GateIndex
            }
        )

        print("Joined Gate:", GateIndex)
    else
        warn("No valid gate found")
    end
end)

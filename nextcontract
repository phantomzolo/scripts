local r5 = game:GetService("ReplicatedStorage")
local w5 = game:GetService("Workspace")

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local f9 = r5.endpoints.server_to_client.game_finished
local v2 = r5.endpoints.client_to_server.set_game_finished_vote
local l7 = w5._GATES.gates

local p1 = {
    ["Godlike Contract"] = 6,
    ["Mythic Contract"] = 5,
    ["Legendary Contract"] = 4,
    ["Elite Contract"] = 3,
    ["Standard Contract"] = 2,
    ["Rookie Contract"] = 1,
}

local function x8()
    local g4
    local n6
    local i3
    local h1 = 0

    for s2 = 1, 11 do
        local b7 = l7:FindFirstChild(tostring(s2))

        if b7 and b7:FindFirstChild("GateType") then
            local z5 = b7.GateType.Value
            local c4 = b7:FindFirstChild("challenge")

            -- ignore double_cost
            if c4 and c4.Value == "double_cost" then
                print("skip:", b7.Name)
                continue
            end

            print("r8:", b7.Name, z5)

            if z5 and p1[z5] and p1[z5] > h1 then
                h1 = p1[z5]
                g4 = b7.Name
                n6 = z5
                i3 = s2
            end
        end
    end

    return g4, n6, i3
end

f9.OnClientEvent:Connect(function()
    print("f9")

    task.wait(2)

    local g4, n6, i3 = x8()

    if g4 and i3 then
        print("x8:", g4, n6)

        v2:InvokeServer(
            "play_gate_next",
            {
                GateUuid = i3
            }
        )

        print("v2:", i3)
    end
end)

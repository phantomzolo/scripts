---------------------------------------------------------------------
-- VARIABLES + FUNCTIONS
---------------------------------------------------------------------
local autoSelectEnabled = true

ToggleButton.MouseButton1Click:Connect(function()
	autoSelectEnabled = not autoSelectEnabled
	ToggleButton.Text = autoSelectEnabled and "Auto Select: ON" or "Auto Select: OFF"
	ToggleButton.BackgroundColor3 = autoSelectEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end)

local function clearPortalButtons()
	for _, child in ipairs(PortalListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function safeGetPortalData(portal)
	if typeof(portal) ~= "table" then return nil end
	if not portal._unique_item_data then return nil end
	if not portal._unique_item_data._unique_portal_data then return nil end
	return portal._unique_item_data._unique_portal_data
end

local function createPortalButton(portal, index)
	local pd = safeGetPortalData(portal)
	if not pd then return end

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -10, 0, 45)
	button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.SourceSansBold
	button.TextSize = 16
	button.Text = string.format("Portal %d | Depth %d | Reward %.2f", index, pd.portal_depth or 0, pd._portal_reward_scale or 0)
	button.Parent = PortalListFrame

	button.MouseButton1Click:Connect(function()
		print("[Portal Auto] Manual select:", index)
		RequestPortal:FireServer(index)
		clearPortalButtons()
	end)
end

print("[Portal Auto] Fully loaded. Waiting for portal list...")

---------------------------------------------------------------------
-- MAIN EVENT — THIS PART WAS BREAKING (NOW PATCHED)
---------------------------------------------------------------------

Select_Portals.OnClientEvent:Connect(function(portalList)

	-----------------------------------------------------------------
	-- SAFETY VALIDATION (FIXES THE NIL CALL ERROR)
	-----------------------------------------------------------------
	if typeof(portalList) ~= "table" then
		warn("[Portal Auto] INVALID portalList: not a table. Ignored.")
		return
	end

	-- Check first entry structure
	local first = portalList[1]
	if not first
		or typeof(first) ~= "table"
		or not first._unique_item_data
		or not first._unique_item_data._unique_portal_data then

		warn("[Portal Auto] Event triggered but NOT portal data. Ignored.")
		return
	end

	print("[Portal Auto] Valid portal list received.")

	-----------------------------------------------------------------
	clearPortalButtons()

	if autoSelectEnabled then
		-----------------------------------------------------------------
		-- PRIORITY 1: depth 11 highest reward
		-----------------------------------------------------------------
		local bestDepth11 = nil
		local highest11 = -math.huge

		for i, portal in ipairs(portalList) do
			local pd = safeGetPortalData(portal)
			if pd and pd.portal_depth == 11 and pd._portal_reward_scale > highest11 then
				bestDepth11 = i
				highest11 = pd._portal_reward_scale
			end
		end

		if bestDepth11 then
			print("[Portal Auto] Selecting DEPTH 11 portal:", bestDepth11)
			RequestPortal:FireServer(bestDepth11)
			return
		end

		-----------------------------------------------------------------
		-- PRIORITY 2: depth > 1 highest reward
		-----------------------------------------------------------------
		local fallback = nil
		local bestFallback = -math.huge

		for i, portal in ipairs(portalList) do
			local pd = safeGetPortalData(portal)
			if pd and pd.portal_depth > 1 and pd._portal_reward_scale > bestFallback then
				fallback = i
				bestFallback = pd._portal_reward_scale
			end
		end

		if fallback then
			print("[Portal Auto] Selecting fallback portal:", fallback)
			RequestPortal:FireServer(fallback)
			return
		end

		warn("[Portal Auto] No valid portal found.")
		return

	else
		-----------------------------------------------------------------
		-- MANUAL MODE
		-----------------------------------------------------------------
		for i, portal in ipairs(portalList) do
			createPortalButton(portal, i)
		end
	end
end)

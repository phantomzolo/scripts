-------------------------
-- SERVICES
-------------------------
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = ReplicatedStorage:WaitForChild("endpoints").client_to_server
local Select_Portals = Remotes:WaitForChild("select_portal")

-------------------------
-- SETTINGS
-------------------------
local AutoReaderEnabled = false

-------------------------
-- SAFE CALL
-------------------------
local function safeCall(fn, ...)
    if typeof(fn) == "function" then
        local ok, result = pcall(fn, ...)
        if ok then return result end
    end
    return nil
end

-------------------------
-- SAFE INDEX
-------------------------
local function getSafe(val, pathStr)
    local current = val
    for key in string.gmatch(pathStr, "[^.]+") do
        if typeof(current) ~= "table" then return nil end
        current = current[key]
    end
    return current
end

-------------------------
-- PORTAL VALIDATOR
-------------------------
local function isValidPortalList(list)
    if typeof(list) ~= "table" then return false end
    local first = list[1]
    if typeof(first) ~= "table" then return false end
    if typeof(first._unique_item_data) ~= "table" then return false end
    if typeof(first._unique_item_data._unique_portal_data) ~= "table" then return false end
    return true
end


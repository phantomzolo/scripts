-------------------------
-- GUI BUTTON LOGIC
-------------------------
ToggleBtn.MouseButton1Click:Connect(function()
    AutoReaderEnabled = not AutoReaderEnabled

    if AutoReaderEnabled then
        ToggleBtn.Text = "Disable"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 60, 60)
        Status.Text = "Status: ON"
    else
        ToggleBtn.Text = "Enable"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        Status.Text = "Status: OFF"
    end
end)

-------------------------
-- PORTAL EVENT
-------------------------
Select_Portals.OnClientEvent:Connect(function(portalList)
    if not AutoReaderEnabled then return end

    if typeof(portalList) ~= "table" then
        warn("[Portal Reader] Skipped (invalid data).")
        return
    end

    if not isValidPortalList(portalList) then
        warn("[Portal Reader] Not portal data.")
        return
    end

    print("====== PORTAL DETECTED ======")

    for i, portal in pairs(portalList) do
        local portalData = getSafe(portal, "_unique_item_data._unique_portal_data")
        if portalData then
            print("Dungeon:", portalData.dungeon_id)
            print("Difficulty:", portalData.difficulty)
            print("World:", portalData.world)
        end
    end

    print("========= END =========")
end)

print("[Portal Reader] GUI + Bypass Loaded.")

---------------------------------------------------------------------
-- SAFE FUNCTIONS
---------------------------------------------------------------------

-- SAFE CLEAN BUTTON RESET
local function clearPortalButtons()
	for _, child in ipairs(PortalListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

-- SAFE PORTAL DATA GETTER (never returns nil)
local function getPortalData(portal)
	-- portal must be a table
	if typeof(portal) ~= "table" then return nil end

	local uid = portal._unique_item_data
	if typeof(uid) ~= "table" then return nil end

	local up = uid._unique_portal_data
	if typeof(up) ~= "table" then return nil end

	-- all values exist safely
	return up
end

-- SAFE BUTTON CREATION
local function createPortalButton(portal, index)
	local pd = getPortalData(portal)
	if not pd then return end

	local depth = pd.portal_depth or 0
	local reward = pd._portal_reward_scale or 0

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -10, 0, 45)
	button.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.SourceSansBold
	button.TextSize = 16
	button.Text = string.format("Portal %d | Depth %d | Reward %.2f", index, depth, reward)
	button.Parent = PortalListFrame

	button.MouseButton1Click:Connect(function()
		RequestPortal:FireServer(index)
		clearPortalButtons()
	end)
end

---------------------------------------------------------------------
-- MAIN LOGIC (WITH COMPLETE NIL PROTECTION)
---------------------------------------------------------------------

local autoSelect = true

ToggleButton.MouseButton1Click:Connect(function()
	autoSelect = not autoSelect
	ToggleButton.Text = autoSelect and "Auto Select: ON" or "Auto Select: OFF"
	ToggleButton.BackgroundColor3 = autoSelect and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
end)

Select_Portals.OnClientEvent:Connect(function(portalList)

	-----------------------------------------------------------------
	-- STEP 1: ENSURE portalList IS A VALID TABLE
	-----------------------------------------------------------------
	if typeof(portalList) ~= "table" or not portalList[1] then
		warn("[Portal Auto] Invalid event data. Ignored safely.")
		return
	end

	-----------------------------------------------------------------
	-- STEP 2: ENSURE FIRST PORTAL HAS VALID STRUCTURE
	-----------------------------------------------------------------
	if not getPortalData(portalList[1]) then
		warn("[Portal Auto] Event does not match portal data. Ignored.")
		return
	end

	print("[Portal Auto] Valid portal list received")

	clearPortalButtons()

	-----------------------------------------------------------------
	-- AUTO MODE
	-----------------------------------------------------------------
	if autoSelect then
		local depth11Index = nil
		local bestD11Reward = -math.huge

		-- PRIORITY 1: Depth 11
		for i, portal in ipairs(portalList) do
			local pd = getPortalData(portal)
			if pd and pd.portal_depth == 11 and pd._portal_reward_scale > bestD11Reward then
				depth11Index = i
				bestD11Reward = pd._portal_reward_scale
			end
		end

		if depth11Index then
			RequestPortal:FireServer(depth11Index)
			return
		end

		-- PRIORITY 2: Highest reward for depth > 1
		local fallbackIndex = nil
		local fallbackReward = -math.huge

		for i, portal in ipairs(portalList) do
			local pd = getPortalData(portal)
			if pd and pd.portal_depth > 1 and pd._portal_reward_scale > fallbackReward then
				fallbackIndex = i
				fallbackReward = pd._portal_reward_scale
			end
		end

		if fallbackIndex then
			RequestPortal:FireServer(fallbackIndex)
		end

		return
	end

	-----------------------------------------------------------------
	-- MANUAL MODE
	-----------------------------------------------------------------
	for i, portal in ipairs(portalList) do
		createPortalButton(portal, i)
	end
end)
